# Copy to .env (git-ignored) or set these in your shell. Nothing here is required:
# without a Gemini key AuditCore falls back to rough offline (heuristic) scores.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_BROAD=
GEMINI_MODEL_DEEP=
GEMINI_CONCURRENCY=8
GEMINI_RPM=0
# GitHub: one token, or several comma-separated for higher API limits
GITHUB_TOKEN=
GITHUB_TOKENS=
AUDITCORE_LANDSCAPE=auto
AUDITCORE_WORKERS=8
AUDITCORE_TICK_SECONDS=30
